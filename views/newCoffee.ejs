<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>document</title>
   <link rel="stylesheet" href="/style.css">
    </head>

    <body>
    <%- include('partials/navbar.ejs') %>
  

<h1>create your own coffee</h1>
 
<form action="/coffees" method="POST">
  <label for="name">Name:</label>
  <input type="text" id="name" name="name" required>
  <br>
  <label for="description">Description:</label>
  <input type="text" id="description" name="description" required>
<br>
  <label for="image">Image URL:</label>
  <input type="text" id="image" name="image" required>
  <br>
 
  <label for="price">Price:</label>
  <input type="number" id="price" name="price" required>
  <br>      
  
  <label for="country">Country:</label>
  <input type="text" id="country" name="country" required>
  <br>
  <label for="isDecaf">Is Decaf:</label>
  <input type="checkbox" id="isDecaf" name="isDecaf">
  <br>
  <button type="submit">Create Coffee</button>
</form>
<!-- scriptlet tag  : javascript logic in the ejs file (for loops, if statements)-->

    </body>
</html>