<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>document</title>
   <link rel="stylesheet" href="/style.css">
    </head>

    <body>
        <%- include('partials/navbar.ejs') %>
<%if (coffees.length === 0) { %>
  <p>No coffees available.</p>
  <a href="/coffees/new">Add a new coffee</a>
<% } else { %>
  
    <% } %>

<h1>All Coffee Beans</h1>
<ul>
  <% coffees.forEach(coffee => { %>
    <li>
      <h2><%= coffee.name %></h2>
      <a href="/coffees/<%= coffee._id %>">See Details</a>
    
    </li>
  <% }) %>
</ul>


<!-- scriptlet tag  : javascript logic in the ejs file (for loops, if statements)-->

    </body>
</html>